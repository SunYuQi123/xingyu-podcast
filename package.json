{
  "name": "xingyu-podcast",
  "version": "0.2.1",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check preload.js && node --check renderer.js && node --check sync-core.js",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "test": "node --test tests/*.test.js"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "productName": "星屿播客",
  "description": "非官方小宇宙 Windows 桌面播客客户端",
  "author": "星屿贡献者",
  "license": "MIT",
  "build": {
    "appId": "io.github.sunyuqi123.xingyu",
    "productName": "星屿播客",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "style.css",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "package.json",
      "sync-core.js"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false,
      "artifactName": "Xingyu-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
